# minikube reads these MINIKUBE_* variables
# see https://minikube.sigs.k8s.io/docs/handbook/config/#environment-variables
#
# The settings are applied when the cluster is created

MINIKUBE_PROFILE=mom-foss-dev
MINIKUBE_DRIVER=docker
MINIKUBE_NODES=1
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=4g
MINIKUBE_KUBERNETES_VERSION=v1.36.4

