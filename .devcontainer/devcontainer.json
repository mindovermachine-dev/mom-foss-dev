{
  "name": "MoM Sovereign FOSS Stack DevContainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers-extra/features/opentofu:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/node:2.1.2": {
      "version": "24"
    },
    //    "ghcr.io/devcontainers-extra/features/flux:1": {
    //      "version": "latest"
    //    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "gh ext install devx-cafe/gh-insitu && gh insitu run post-create",
  //  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y s3cmd jq yq && tofu --version && helm version && kubectl version --client && flux --version && aws --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "opentofu.vscode-opentofu",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "weaveworks.vscode-gitops-tools",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "mk12.better-git-line-blame"
      ]
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME},target=/localhome,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  }
}
